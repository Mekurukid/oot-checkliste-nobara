#!/bin/sh
set -eu
APPDIR="$HOME/.local/share/oot-checklisten"
OLD_APP1="$HOME/.local/share/oot-checklisten"
OLD_APP2="$HOME/.local/share/oot-herzteil-checkliste-programm"
TMPDIR="${TMPDIR:-/tmp}/oot-checkliste-v27-$$"
cleanup(){ rm -rf "$TMPDIR"; }
trap cleanup EXIT HUP INT TERM
mkdir -p "$TMPDIR"

# Stop an older local installation before replacing program files.
for old in "$OLD_APP1" "$OLD_APP2"; do
  if [ -x "$old/STOPPEN.sh" ]; then
    sh "$old/STOPPEN.sh" >/dev/null 2>&1 || true
  fi
done
sleep 1

PAYLOAD_LINE=$(awk '/^__PAYLOAD__$/ {print NR + 1; exit 0;}' "$0")
tail -n +"$PAYLOAD_LINE" "$0" | base64 -d > "$TMPDIR/app.tar.gz"
tar -xzf "$TMPDIR/app.tar.gz" -C "$TMPDIR"

rm -rf "$APPDIR"
mkdir -p "$(dirname "$APPDIR")"
cp -a "$TMPDIR/oot-checkliste-nobara" "$APPDIR"
chmod +x "$APPDIR"/*.sh 2>/dev/null || true

sh "$APPDIR/NOBARA-INSTALLIEREN.sh" >/dev/null 2>&1 || true
exec sh "$APPDIR/STARTEN.sh"
exit 0
